{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixar-cars-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
