{
  "name": "pixar-cars-social-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pixar-cars-social-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pixar-cars-social-db --remote",
    "check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
